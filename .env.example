# ==============================================================================
# SentinelAI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate your sensitive credentials.
# NEVER commit the real '.env' file to your Git repository.
# ==============================================================================

# Google Gemini API Key for AI Threat Intelligence & Explainer Copilot
# Get your free API key at: https://aistudio.google.com/app/apikey
# If left blank, SentinelAI will automatically run in Deterministic Offline Fallback Mode.
GEMINI_API_KEY=your_gemini_api_key_here

# SentinelAI Operational Environment ('development', 'testing', 'production')
SENTINEL_ENV=development

# Incident Response Execution Mode ('dry_run' or 'live')
# In 'dry_run' mode, firewall containment commands are validated and simulated without modifying OS state.
RESPONSE_MODE=dry_run

# Detection Sensitivity Thresholds
PORT_SCAN_THRESHOLD=10
PORT_SCAN_WINDOW_SECONDS=60
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=60
DDOS_PACKET_THRESHOLD=800
HIGH_VOLUME_THRESHOLD=350
