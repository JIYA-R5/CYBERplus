# ==============================================================================
# SentinelAI — Environment Configuration Template
# Copy this file to '.env' before starting Docker Compose or local services:
#   copy .env.example .env   (Windows PowerShell / CMD)
#   cp .env.example .env     (Linux / macOS)
#
# IMPORTANT SECURITY NOTICE:
# Never commit '.env' or real API credentials to Git. Use Docker secrets or
# cloud key management systems for production deployments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Threat Reasoning (Google Gemini)
# ------------------------------------------------------------------------------
# Optional: Enter your Google AI Studio Gemini API key to enable live LLM threat
# reasoning, executive briefings, and dual-hypothesis analysis.
# If left empty, SentinelAI automatically falls back to its deterministic
# offline MITRE ATT&CK knowledge base without crashing.
GEMINI_API_KEY=

# Google Gemini model ID (e.g. gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
# Default is gemini-2.5-flash with automatic cascading fallback.
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Service Endpoints & Networking
# ------------------------------------------------------------------------------
# FastAPI backend host and port
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit dashboard port
DASHBOARD_PORT=8501

# Dashboard-to-API communication URL
# Inside Docker Compose network, use the internal service name: http://api:8000
# For local development outside containers, use: http://localhost:8000
API_BASE_URL=http://api:8000

# Endpoint Agent API destination URL
# Inside Docker Compose: http://api:8000
# Running on same laptop: http://localhost:8000
# Running on a second laptop: http://<LAPTOP_1_LAN_IP>:8000
SENTINEL_API_URL=http://api:8000

# Allowed CORS origins for the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# 3. Persistent Storage Paths & Log Retention
# ------------------------------------------------------------------------------
# Primary SQLite database file path (central persistent store)
DATABASE_PATH=data/sentinelai_production.db
SENTINEL_DB_PATH=data/sentinelai_production.db

# Automated 24-hour safe-log deletion threshold in hours (default: 24)
SAFE_LOG_RETENTION_HOURS=24

# Path to machine learning models directory. In Docker, maps to 'sentinel_models' volume.
SENTINEL_MODEL_DIR=/app/models

# ------------------------------------------------------------------------------
# 4. Security & Authentication Keys
# ------------------------------------------------------------------------------
# Shared secret required for endpoint telemetry agent ingestion (X-Agent-Secret header)
SENTINEL_AGENT_SECRET=sentinel-agent-secret-token-change-in-prod

# Optional administrator key for privileged operations (containment actions, ML retraining)
# If left blank in local/demo mode, administrative actions are permitted.
SENTINEL_ADMIN_KEY=

# ------------------------------------------------------------------------------
# 5. Endpoint Telemetry Agent Settings
# ------------------------------------------------------------------------------
# Collection mode:
#   'synthetic' - Recommended inside Docker containers (Linux containers cannot see Windows host traffic)
#   'native'    - Recommended when running agent directly on Windows host OS
#   'file'      - Ingest from a specified JSON/CSV log file
AGENT_MODE=synthetic

# Interval in seconds between telemetry collection cycles
AGENT_INTERVAL=15

# Friendly host identifier for the agent
AGENT_HOST_ID=sentinel-workstation-01

# ------------------------------------------------------------------------------
# 6. Message Broker & Relational Persistence
# ------------------------------------------------------------------------------
# Redis Streams message broker URL for real-time telemetry buffering
# In Docker Compose: redis://redis:6379/0
# Local development on Windows host: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# PostgreSQL relational database connection string
# In Docker Compose: postgresql://sentinel:sentinel_secret@db:5432/sentinel_db
# Local development on Windows host: postgresql://sentinel:sentinel_secret@localhost:5432/sentinel_db
DATABASE_URL=postgresql://sentinel:sentinel_secret@localhost:5432/sentinel_db

# ------------------------------------------------------------------------------
# 7. Supervised Windows TShark Live Network Collector Settings
# ------------------------------------------------------------------------------
# Active host capture interface name or index (e.g. 'Wi-Fi', 'Ethernet', or numeric index from 'tshark -D')
SENTINEL_CAPTURE_INTERFACE=Wi-Fi

# Optional Berkeley Packet Filter (BPF) string (e.g. 'tcp or udp', 'not port 22')
SENTINEL_BPF_FILTER=

# Batch transmission interval (seconds) and batch size (flows)
SENTINEL_COLLECTOR_INTERVAL=3.0
SENTINEL_COLLECTOR_BATCH_SIZE=25

# ------------------------------------------------------------------------------
# 8. Source IP Geolocation & Threat Intelligence (MaxMind GeoLite2 / HTTP Provider)
# ------------------------------------------------------------------------------
# Provider mode: 'local' (MaxMind GeoLite2-City.mmdb binary database) or 'external' (rate-limited HTTP)
GEOIP_PROVIDER=local

# Local MaxMind GeoLite2-City database file path
# Download legitimately from: https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# In Docker, mount to /app/data/GeoLite2-City.mmdb
MAXMIND_GEOIP_DB_PATH=data/GeoLite2-City.mmdb
GEOIP_DB_PATH=data/GeoLite2-City.mmdb

# Geolocation cache TTL in hours (in-memory and SQLite persistent cache)
GEOIP_CACHE_TTL_HOURS=24

